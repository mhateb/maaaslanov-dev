#!/bin/sh

branch=$(git branch --show-current) || exit 1
if [ "$branch" != "main" ]; then
  exit 0
fi

runner=$(git config --local --get project.agentRunner)
if [ -z "$runner" ]; then
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel) || exit 1
skill_path="$repo_root/.agents/skills/bump-app-version/SKILL.md"
commit_hash=$(git rev-parse HEAD) || exit 1

"$runner" "$skill_path" "$commit_hash"